extends SceneTree
const Settings = preload("res://scripts/settings_panel.gd")
const Voice = preload("res://scripts/voice.gd")
const Radio = preload("res://scripts/radio.gd")
const Network = preload("res://scripts/network.gd")

func _initialize() -> void:
	call_deferred("_run")

func _run() -> void:
	preload("res://tests/creator_bones.gd").run()
	preload("res://tests/avatar_queries.gd").run()
	preload("res://tests/creator_queries.gd").run()
	preload("res://tests/object_events.gd").run()
	preload("res://tests/creator_media.gd").run()
	preload("res://tests/creator_visuals.gd").run()
	preload("res://tests/ambient_visuals.gd").run()
	preload("res://tests/network_rates.gd").run()
	preload("res://tests/partial_poses.gd").run()
	preload("res://tests/creator_animations.gd").run()
	preload("res://tests/advanced_materials.gd").run()
	preload("res://tests/render_budget.gd").run()
	preload("res://tests/light_budget.gd").run()
	preload("res://tests/creator_acoustics.gd").run()
	await preload("res://tests/realistic_acoustics.gd").run()
	preload("res://tests/creator_scheduler.gd").run()
	preload("res://tests/focus.gd").run()
	preload("res://tests/transitions.gd").run()
	await preload("res://tests/loader_cancellation.gd").run()
	await preload("res://tests/voice_epochs.gd").run()
	preload("res://tests/cache.gd").run()
	preload("res://tests/contacts.gd").run()
	preload("res://tests/textures.gd").run()
	assert(Settings.upscalers("mobile", false) == ["bilinear"])
	assert(Settings.upscalers("forward_plus", true) == ["bilinear"])
	assert(Settings.upscalers("forward_plus", false) == ["bilinear", "fsr1"])
	var baseline := AudioServer.bus_count
	var network := Network.new()
	root.add_child(network)
	var voice := Voice.new()
	root.add_child(voice)
	voice.attach(network)
	var radio := Radio.new()
	root.add_child(radio)
	radio.attach(network)
	var viewport := SubViewport.new()
	viewport.size = Vector2i(64,64)
	root.add_child(viewport)
	var preferences := {"input_device":"SSC missing microphone","output_device":"SSC missing speaker","voice_volume":0.25,"microphone_gain":0.5,"quality":2,"resolution_scale":0.75,"antialiasing":"msaa_4x","upscaler":"fsr1","texture_lod_bias":1.0,"can_touch_me":true,"send_divisor":4,"receive_divisor":2}
	var panel := Settings.new()
	root.add_child(panel)
	panel.configure(preferences)
	assert(not panel.controls.has("can_touch_me"))
	assert(panel.controls.quality.get_item_metadata(panel.controls.quality.selected) == 2)
	assert(panel.controls.radial_action_0.get_item_metadata(panel.controls.radial_action_0.selected) == "microphone")
	assert(is_equal_approx(panel.controls.radial_hold_seconds.value, 0.45))
	var edited := {"value":{}}
	panel.changed.connect(func(updates: Dictionary): edited.value = updates)
	panel.controls.radial_action_0.select(panel.controls.radial_action_0.item_count - 1)
	panel.controls.radial_hold_seconds.value = 0.7
	for child in panel.get_children():
		if child is Button and child.text.begins_with("Apply and save"):
			child.pressed.emit()
	assert(edited.value.radial_actions.size() == 8 and edited.value.radial_actions[0] == "none")
	assert(not edited.value.has("radial_action_0") and is_equal_approx(float(edited.value.radial_hold_seconds), 0.7))
	var notices := Settings.apply_local(preferences, viewport, voice, radio)
	assert(notices.size() >= 2)
	assert(AudioServer.input_device == "Default" and AudioServer.output_device == "Default")
	assert(not voice.microphone_enabled)
	assert(is_equal_approx(voice.playback_gain, 0.25) and is_equal_approx(radio.receiver.playback_gain, 0.25))
	assert(is_equal_approx(voice.microphone.volume_linear, 0.5))
	assert(is_equal_approx(viewport.scaling_3d_scale, 0.75) and viewport.msaa_3d == Viewport.MSAA_4X)
	assert(is_equal_approx(viewport.texture_mipmap_bias, 1.0))
	assert(viewport.scaling_3d_mode == Viewport.SCALING_3D_MODE_BILINEAR)
	panel.free()
	viewport.free()
	radio.free()
	voice.free()
	network.free()
	assert(AudioServer.bus_count == baseline)
	await process_frame
	print("PASS account settings controls, conservative upscaler fallback, exact voice gain, missing-device mute and audio-bus cleanup")
	quit()
