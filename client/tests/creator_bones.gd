extends RefCounted
const Humanoid = preload("res://scripts/humanoid.gd")
const CreatorRuntime = preload("res://scripts/creator_runtime.gd")

static func run() -> void:
	var tree: SceneTree = Engine.get_main_loop()
	var humanoid := Humanoid.new()
	var other := Humanoid.new()
	var model := Node3D.new()
	var skeleton := Skeleton3D.new()
	model.add_child(skeleton)
	for index in 65:
		skeleton.add_bone("bone%s" % index)
	tree.root.add_child(humanoid)
	humanoid.setup(model)
	tree.root.add_child(other)
	var other_model := Node3D.new()
	var other_skeleton := Skeleton3D.new()
	other_model.add_child(other_skeleton)
	other_skeleton.add_bone("bone0")
	other.setup(other_model)
	var runtime := CreatorRuntime.new()
	tree.root.add_child(runtime)
	runtime.scope = humanoid
	runtime.set_process(false)
	var vm = ClassDB.instantiate("CreatorVm")
	assert(vm.load_script("avatar.on('action',function() avatar.bone_rotation('bone0',0,0.5,0,0.5) end); avatar.on('release',function() avatar.reset_bone('bone0') end)", PackedStringArray(["visual"])).is_empty())
	runtime.scripts.append({"vm":vm,"attachment":"avatar","failed":false})
	var errors: Array[String] = []
	runtime.script_error.connect(func(message: String): errors.append(message))
	runtime.dispatch("action", {})
	humanoid.bone_modifier._process_modification()
	var rotation := Quaternion(0, sqrt(0.5), 0, sqrt(0.5))
	assert(skeleton.get_bone_pose_rotation(0).is_equal_approx(rotation))
	assert(other_skeleton.get_bone_pose_rotation(0).is_equal_approx(Quaternion.IDENTITY))
	runtime.dispatch("release", {})
	assert(humanoid.bone_modifier.rotations.is_empty())
	assert(skeleton.get_bone_pose_rotation(0).is_equal_approx(Quaternion.IDENTITY))
	assert(humanoid.creator_bone({"action":"reset_bone","target":"../bone0"}).begins_with("Unknown"))
	runtime._apply({"action":"bone_rotation","target":"bone0","rotation":[0,1,0,0]}, "bone1")
	assert(humanoid.bone_modifier.rotations.is_empty())
	for index in 64:
		assert(humanoid.creator_bone({"action":"bone_rotation","target":"bone%s" % index,"rotation":[0,0,0,1]}).is_empty())
	assert(not humanoid.creator_bone({"action":"bone_rotation","target":"bone64","rotation":[0,0,0,1]}).is_empty())
	assert(humanoid.bone_modifier.rotations.size() == 64 and errors.is_empty())
	assert(humanoid.bone_modifier.get_index(true) < humanoid.grab_modifier.get_index(true))
	var retired: WeakRef = weakref(humanoid.bone_modifier)
	runtime.free()
	humanoid.free()
	other.free()
	assert(retired.get_ref() == null)
	print("PASS capability-gated avatar bone commands, own-skeleton/attachment isolation, override limit, reset and teardown")
