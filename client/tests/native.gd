extends SceneTree
const Acoustics = preload("res://scripts/acoustics.gd")
const Network = preload("res://scripts/network.gd")
const RadialMenu = preload("res://scripts/radial_menu.gd")
const Radio = preload("res://scripts/radio.gd")
var started := 0

func _initialize() -> void:
	started = Time.get_ticks_msec()
	assert(ClassDB.class_exists("CreatorVm"), "Creator VM native class missing")
	assert(ClassDB.class_exists("OpusCodec"), "Opus native class missing")
	var vm = ClassDB.instantiate("CreatorVm")
	var error: String = vm.load_script("while true do end", PackedStringArray())
	assert(not error.is_empty(), "Infinite client script was not interrupted")
	error = vm.load_script("assert(os == nil and io == nil and require == nil); avatar.on('action', function(e) avatar.expression('happy', e.weight) end)", PackedStringArray(["visual"]))
	assert(error.is_empty(), error)
	var result: Dictionary = JSON.parse_string(vm.dispatch("action", '{"weight":0.7}'))
	assert(result.commands[0].target == "happy")
	vm.close()
	var encoder = ClassDB.instantiate("OpusCodec")
	var decoder = ClassDB.instantiate("OpusCodec")
	assert(encoder.configure(24000) and decoder.configure(24000))
	var samples := PackedVector2Array()
	for i in 960:
		var v := sin(float(i) * TAU * 440.0 / 48000.0) * 0.1
		samples.append(Vector2(v,v))
	var packet: PackedByteArray = encoder.encode(samples)
	assert(not packet.is_empty())
	var output: PackedVector2Array = decoder.decode(packet)
	assert(output.size() == 960)
	assert(output[500].is_finite())
	var baseline := AudioServer.bus_count
	var acoustics := Acoustics.new()
	acoustics.configure([{"id":"small_wet_room","position":[0,0,0],"size":[1,1,1],"effects":{"reverb":0.95,"echo":0.8,"distortion":0.7,"compression":true}}], 0.4)
	var bus: StringName = acoustics.route(Vector3.ZERO)
	assert(bus != &"Master" and acoustics.route(Vector3(2,0,0)) == &"Master")
	assert(acoustics.route(Vector3.ZERO, true) == &"Master")
	var index := AudioServer.get_bus_index(bus)
	assert(AudioServer.get_bus_effect_count(index) == 5)
	assert(is_equal_approx(AudioServer.get_bus_effect(index,0).wet, 0.4))
	acoustics.clear()
	assert(AudioServer.bus_count == baseline)
	acoustics.free()
	print("PASS named acoustic zones, Godot reverb/delay/distortion/compression, admin ceiling, dry path and bus cleanup")
	var transport := Network.new()
	var now := Time.get_ticks_msec() / 1000.0
	transport._decode(23, JSON.stringify({"sent":now - 0.02,"server":100.0}).to_utf8_buffer())
	assert(transport.clock_ready)
	var timeline: Dictionary = transport.media_timeline({"position":10.0,"playing":true,"rate":2.0,"sampled_at":99.0})
	assert(float(timeline.position) > 12.0 and float(timeline.position) < 12.2)
	transport.free()
	assert(RadialMenu.sector(Vector2.ZERO) == -1)
	assert(RadialMenu.sector(Vector2(0,1)) == 0)
	assert(RadialMenu.sector(Vector2(1,0)) == 2)
	assert(RadialMenu.sector(Vector2(0,-1)) == 4)
	assert(RadialMenu.sector(Vector2(-1,0)) == 6)
	var grayscale := PackedByteArray()
	grayscale.resize(64*48)
	grayscale.fill(160)
	var sstv: Image = Radio.degraded_image(grayscale,12)
	assert(sstv and sstv.get_width() == 64 and sstv.get_height() == 48)
	assert(sstv.get_data() != grayscale)
	assert(Radio.degraded_image(PackedByteArray(),12) == null)
	print("PASS Godot native client Luau sandbox/watchdog/capabilities and libopus roundtrip")
	quit()

func _process(_delta: float) -> bool:
	if Time.get_ticks_msec() - started > 5000:
		quit(2)
	return false
